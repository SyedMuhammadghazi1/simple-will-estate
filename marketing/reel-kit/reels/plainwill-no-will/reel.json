        {
          "at": "w:a",
          "face": "think",
          "pose": "chin"
        },
        {
          "at": "w:decide",
          "face": "happy",
          "pose": "cheer",
          "hop": 30
        }
      ]
    },
    {
      "id": "how",
      "caption": "Who gets *what.* Who you'd *name* for kids. Who's in *charge.*",
      "props": [
        {
          "type": "checklist",
          "x": 674,
          "y": 968,
          "rot": -2,
          "w": 640,
          "title": "You decide",
          "kicker": "the core of a will",
          "items": [
            {
              "text": "Who gets what",
              "at": "w:what"
            },
            {
              "text": "Who you'd name for kids",
              "at": "w:kids"
            },
            {
              "text": "Who's in charge",
              "at": "w:charge"
            }
          ],
          "scale": 0.94
        },
        {
          "type": "note",
          "x": 596,
          "y": 1190,
          "rot": 1,
          "w": 436,
          "enter": "pop",
          "delay": 0.3,
          "text": "* you name your choice;\n  a court may still OK it"
