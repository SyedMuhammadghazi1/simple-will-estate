    {
      "id": "dark",
      "mood": "dark",
      "gap": 0.5,
      "caption": "Unsigned? The state's version is *still yours.*",
      "mascot": [
        {
          "at": 0,
          "face": "deadpan",
          "pose": "rest",
          "hop": 0
        }
      ],
      "props": [
        {
          "type": "doc-stamp",
          "x": 690,
          "y": 1022,
          "rot": -3,
          "scale": 0.9,
          "enter": "pop",
          "exit": "fade",
          "subtitle": "Last will of",
          "title": "You.",
          "bylineLabel": "Written by:",
          "byline": "your state",
          "typeAt": -1,
          "stamp": "Still yours",
          "stampAt": "w:still",
          "chip": "your will: unsigned",
          "chipAt": "w:unsigned+0.2",
          "chipX": 41
