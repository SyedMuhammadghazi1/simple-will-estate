  "endcard": {
    "headline": "Follow for the rules\nnobody reads,\n*in plain English*",
    "say": "Follow for the rules nobody reads, in plain English.",
    "sub": "Want the one-page checklist? See the caption.",
    "brand": "plainwill",
    "disclaimer": "Plainwill is not a law firm and is not a substitute for the advice of an attorney.",
