# ---------------------------------------------------------------------------
# Plainwill environment variables. Copy to .env for local development:
#   cp .env.example .env
# NEVER commit real secrets. Production values live in your host's secret store.
# ---------------------------------------------------------------------------

# Runtime mode. `next dev` sets development, `next start`/Docker set production.
# NODE_ENV=development

# --- Branding --------------------------------------------------------------
# Product name shown in the UI, emails and documents (build-time for client code).
NEXT_PUBLIC_APP_NAME=Plainwill
# Public base URL (used in client code and emails).
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Server ----------------------------------------------------------------
# Canonical base URL of the app (Better Auth callbacks, Stripe redirect URLs, email links).
APP_URL=http://localhost:3001
# Client IP detection (rate limits, audit log, sessions) — see docs/DEPLOYMENT.md#client-ip-addresses.
# Either ONE header your platform sets and clients cannot forge (x-real-ip on Vercel, fly-client-ip
# on Fly.io, cf-connecting-ip behind Cloudflare); when set, it is the only source:
CLIENT_IP_HEADER=
# …or how many reverse proxies in front of the app APPEND to X-Forwarded-For. The client IP is the
# entry that many positions from the right (entries further left can be forged by the client).
# Default 1 (Render, Railway, Heroku, one nginx); 0 = never trust X-Forwarded-For (no proxy).
TRUSTED_PROXY_HOPS=1

# --- Database --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/simple_will_dev
# Max connections per app instance.
DATABASE_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Secret used by Better Auth to sign session cookies. >= 32 chars. `openssl rand -base64 48`
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop

# --- Encryption of sensitive data at rest ----------------------------------
# 32-byte AES-256-GCM key, base64 encoded. `openssl rand -base64 32`
# Losing this key makes all questionnaire answers, documents and uploads unreadable — back it up
# in your secret manager. See docs/RUNBOOK.md for rotation.
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Identifier written into every ciphertext (letters, digits, _ or -).
DATA_ENCRYPTION_KEY_ID=k1
# Old keys kept for decryption only after a rotation: comma separated "id:base64key" pairs.
DATA_ENCRYPTION_PREVIOUS_KEYS=

# --- Payments --------------------------------------------------------------
# "stripe" (default) or "test-bypass". test-bypass marks orders paid WITHOUT Stripe for local
# development and e2e tests; it is rejected at startup and ignored in code when
# NODE_ENV=production.
PAYMENTS_MODE=test-bypass
# Stripe secret key (sk_test_... / sk_live_...). Required in production.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint /api/webhooks/stripe (whsec_...). Required in production.
STRIPE_WEBHOOK_SECRET=

# --- Email -----------------------------------------------------------------
# SMTP server. When SMTP_HOST is empty, emails are logged to the console instead of sent.
# Local Mailpit (docker compose up -d mailpit): SMTP_HOST=localhost SMTP_PORT=1025, UI on :8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# From address for transactional email (must be a verified sending domain in production).
EMAIL_FROM="Plainwill <no-reply@plainwill.example>"
# Shown to customers as the support contact.
SUPPORT_EMAIL=support@plainwill.example

# --- Background jobs -------------------------------------------------------
# Bearer token required by POST /api/cron/*. >= 16 chars. Required in production.
CRON_SECRET=dev-cron-secret-change-me

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent (default: info, debug in development)
LOG_LEVEL=

# --- Build -----------------------------------------------------------------
# Set to 1 only for `next build` in CI/Docker when runtime secrets are unavailable. A production
# server (NODE_ENV=production outside `next build`) ignores it and always validates.
# SKIP_ENV_VALIDATION=1
